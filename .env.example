# Instagram Graph API (Instagram professional account linked to your Meta app)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Instagram needs a PUBLIC url for the video. Cloudinary free tier works well.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: path to a .ttf/.otf font (needed for Chinese/Japanese poems)
# FONT_PATH=/usr/share/fonts/truetype/noto/NotoSerifCJK-Regular.ttc
